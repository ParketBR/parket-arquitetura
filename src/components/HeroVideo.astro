---
/**
 * Fundo em vídeo do hero.
 * O pôster é quem carrega primeiro e é o LCP — o vídeo entra depois, sem
 * disputar banda. Não roda com prefers-reduced-motion, em modo de economia de
 * dados nem em conexão lenta: nesses casos o pôster fica, e fica bem.
 */
import { Image } from 'astro:assets';
import poster from '../assets/hero-poster.webp';
import { caminho } from '../lib/url';

interface Props { src?: string; alt: string }
const { src = caminho('/video/hero.mp4'), alt } = Astro.props;
---

<div class="hv" data-hero-video>
  <Image
    class="hv-poster"
    src={poster}
    {alt}
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    format="avif"
    quality={62}
    loading="eager"
    decoding="sync"
    fetchpriority="high"
  />

  <video
    class="hv-video"
    data-video
    muted
    loop
    playsinline
    preload="none"
    tabindex="-1"
    aria-hidden="true"
    disablepictureinpicture
  >
    <source data-src={src} type="video/mp4" />
  </video>
</div>

<style>
  .hv { position: absolute; inset: 0; overflow: hidden; background: var(--ground); }
  .hv-poster,
  .hv-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hv-video { opacity: 0; transition: opacity 1.2s var(--ease); }
  .hv.esta-tocando .hv-video { opacity: 1; }
</style>

<script>
  const caixa = document.querySelector<HTMLElement>('[data-hero-video]');
  const video = caixa?.querySelector<HTMLVideoElement>('[data-video]');
  const fonte = video?.querySelector<HTMLSourceElement>('source');

  function podeTocar(): boolean {
    if (!video || !fonte) return false;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;

    /* O celular tocava só o pôster, por causa dos 3,73 MB do arquivo. Agora
       toca: o enquadramento do pôster já provava que o corte em retrato
       funciona, e o peso não chega de uma vez — o MP4 tem o `moov` antes do
       `mdat`, então o vídeo transmite progressivamente em vez de baixar
       inteiro antes do primeiro quadro. Some-se a isso que ele só começa
       depois do `load`, com o pôster (o LCP) já pintado.

       O que resta de risco é a franquia de dados, e é por isso que as duas
       guardas abaixo continuam. Vale saber que o Safari não implementa
       `navigator.connection`: no iPhone nenhuma das duas tem efeito, e o
       vídeo carrega mesmo no 4G. Um arquivo mais leve resolveria de vez —
       precisa de ffmpeg, que esta máquina não tem. */
    const con = (navigator as any).connection;
    if (con?.saveData) return false;
    if (con?.effectiveType && !/4g/.test(con.effectiveType)) return false;
    return true;
  }

  if (podeTocar() && video && fonte && caixa) {
    const iniciar = () => {
      fonte.src = fonte.dataset.src!;
      video.load();
      video.addEventListener(
        'canplay',
        () => {
          video.play()
            .then(() => caixa.classList.add('esta-tocando'))
            .catch(() => { /* autoplay bloqueado: o pôster permanece */ });
        },
        { once: true },
      );
    };

    // Só depois de a página carregar, para não competir com o LCP.
    if (document.readyState === 'complete') iniciar();
    else addEventListener('load', iniciar, { once: true });

    // Poupa bateria e banda quando a aba ou o hero saem de vista.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause();
      else if (caixa.classList.contains('esta-tocando')) video.play().catch(() => {});
    });

    new IntersectionObserver(
      ([e]) => {
        if (!caixa.classList.contains('esta-tocando')) return;
        if (e.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0 },
    ).observe(caixa);
  }
</script>
