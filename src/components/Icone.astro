---
/**
 * Glifos de contato — telefone e e-mail.
 *
 * Traço em `currentColor` e nada de `fill`: a cor vem de quem usa, e o
 * `.icone--detalhe` de baixo é o único lugar que sabe qual é a cor de detalhe
 * da casa (--wood). Desenhados na mesma malha de 24 e com o mesmo peso de
 * traço das setas da régua de texturas, para o site ter um alfabeto de ícone
 * só.
 *
 * Sempre decorativo: os glifos acompanham um número ou um endereço que já
 * está escrito ao lado, então `aria-hidden` — anunciar "telefone" antes do
 * número seria repetição para quem usa leitor de tela.
 */
interface Props {
  nome: 'telefone' | 'email';
  class?: string;
  tamanho?: number;
}

const { nome, class: cls = '', tamanho = 16 } = Astro.props;
---

<svg class={`icone ${cls}`.trim()} width={tamanho} height={tamanho}
     viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {nome === 'telefone'
    ? <path d="M6.4 3.5h3.1l1.5 3.9-1.9 1.4a12.4 12.4 0 0 0 6.1 6.1l1.4-1.9 3.9 1.5v3.1a1.9 1.9 0 0 1-2.1 1.9A17.2 17.2 0 0 1 4.5 5.6a1.9 1.9 0 0 1 1.9-2.1Z" />
    : <>
        <rect x="2.8" y="5" width="18.4" height="14" rx="0.5" />
        <path d="m2.8 6.6 8.3 6a1.5 1.5 0 0 0 1.8 0l8.3-6" />
      </>}
</svg>

<style>
  .icone {
    flex: none; display: block;
    fill: none; stroke: currentColor; stroke-width: 1.4;
    stroke-linecap: round; stroke-linejoin: round;
  }
  /* A cor de detalhe. --wood tem 2,84:1 e por isso nunca vale como texto —
     num glifo decorativo, com o dado escrito ao lado, vale. */
  .icone--detalhe { color: var(--wood); }
</style>
