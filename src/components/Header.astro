---
/**
 * Cabeçalho da one page.
 *
 * A navegação não abre mais páginas: são âncoras para as seções da home,
 * escritas na forma `/#secao` para que funcionem também a partir de /contato.
 * Os painéis de mega-menu saíram junto com as páginas de produto e espécie —
 * o índice do catálogo agora é a própria página.
 *
 * O CTA é um só, e é o mesmo em toda parte: falar com um especialista.
 */
import { caminho } from '../lib/url';

interface Props { transparente?: boolean }
const { transparente = false } = Astro.props;

const itens = [
  { nome: 'Superfícies', href: caminho('/#superficies'), id: 'superficies' },
  { nome: 'Madeiras',    href: caminho('/#madeiras'),    id: 'madeiras' },
  { nome: 'Acervo',      href: caminho('/#acervo'),      id: 'acervo' },
  { nome: 'Blog',        href: caminho('/blog'),         id: 'blog' },
];

/* Com base (GitHub Pages) o pathname vem prefixado, então a comparação
   também precisa passar pelo helper. */
const naContato = Astro.url.pathname.startsWith(caminho('/contato'));
---

<header class:list={['cab', { 'cab--transp': transparente }]} data-cab>
  <div class="cab-in wrap">
    <a class="marca" href={caminho("/")} aria-label="Parket — página inicial">Parket</a>

    <nav class="nav" aria-label="Principal">
      {itens.map((i) => (
        <a class="nav-l" href={i.href} data-secao={i.id}>{i.nome}</a>
      ))}
    </nav>

    <a class:list={['btn', 'cab-cta', { 'is-ativo': naContato }]} href={caminho("/contato")}>
      Falar com um especialista
    </a>

    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu-mob" data-menu>
      <span class="sr-only">Abrir menu</span>
      <span class="menu-icone" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

</header>

{/* Fora do <header>, e não dentro dele como antes, por um motivo que só
    aparece em uso: a barra tem `backdrop-filter`, e um filtro de fundo faz o
    elemento virar bloco de contenção para descendentes `position: fixed`.
    Dentro do header, este painel se mediria pelos 64px da barra em vez da
    tela — e pior, só quando o filtro estivesse ligado, porque sobre o hero
    ele é `none`. Ficaria certo no topo da home e errado depois de rolar. */}
<div class="mob" id="menu-mob" hidden>
  <nav class="wrap mob-in" aria-label="Menu">
    {itens.map((i, n) => <a class="mob-l" href={i.href} style={`--i:${n}`}>{i.nome}</a>)}
    {/* btn-on-dark, e não o .btn de sempre: o .btn é #1A1A1A e o painel é
        #0D0D0D — 1,2:1, um retângulo que só se enxerga pelo texto. Invertido
        ele fica claro sobre o preto, como o CTA do rodapé, que vive na mesma
        situação. */}
    <a class="btn btn-on-dark mob-cta" href={caminho("/contato")} style={`--i:${itens.length}`}>Falar com um especialista</a>
  </nav>
</div>

<style>
  .cab {
    /* A barra é preta. Sobre o hero ela desaparece (ver .cab--transp), mas do
       primeiro rolar em diante é este o estado. Toda a cor sai destes tokens:
       cada contexto redefine os valores e as regras abaixo não mudam — evita a
       briga de especificidade entre estado de contexto e :hover. */
    --cab-fundo: rgb(26 26 26 / .95);
    --cab-linha: rgb(255 255 255 / .1);
    --cab-blur: blur(12px);
    --nav-cor: rgb(255 255 255 / .6);
    --nav-cor-forte: #FFFFFF;
    --marca-cor: #FFFFFF;
    --cta-fundo: #FFFFFF;
    --cta-texto: var(--preto);
    --cta-borda: #FFFFFF;

    position: sticky; top: 0; z-index: var(--z-header);
    background: var(--cab-fundo);
    border-bottom: 1px solid var(--cab-linha);
    -webkit-backdrop-filter: var(--cab-blur);
    backdrop-filter: var(--cab-blur);
    transition: background var(--d-base) var(--ease), border-color var(--d-base) var(--ease);
  }

  /* Sobre o hero a barra some para a imagem respirar */
  .cab--transp:not(.is-rolado) {
    --cab-fundo: transparent;
    --cab-linha: transparent;
    --cab-blur: none;          /* sobre o hero a imagem fica limpa */
    --nav-cor: rgb(232 228 223 / .78);
    --nav-cor-forte: #FFFFFF;
    --marca-cor: var(--on-dark);
    --cta-fundo: transparent;
    --cta-texto: var(--on-dark);
    --cta-borda: rgb(232 228 223 / .55);

    position: fixed; inset-inline: 0;
  }

  .cab-in {
    display: flex; align-items: center; gap: var(--s-6);
    min-height: 76px;
  }
  .marca {
    display: inline-flex; align-items: center;
    min-height: 44px;   /* alvo de toque; o texto sozinho dava 26px */
    font-size: 1rem; font-weight: 300; letter-spacing: .34em;
    text-transform: uppercase; color: var(--marca-cor); white-space: nowrap;
    transition: color var(--d-base) var(--ease);
  }

  .nav { display: flex; gap: 2px; margin-inline: auto; }
  .nav-l {
    position: relative;
    font-size: var(--fs-label); font-weight: 500;
    letter-spacing: var(--ls-label); text-transform: uppercase;
    color: var(--nav-cor);
    padding: 13px 15px;   /* 44px de altura, alvo de clique confortável */
    white-space: nowrap;
    transition: color var(--d-fast) var(--ease);
  }
  .nav-l:hover,
  .nav-l:focus-visible,
  .nav-l.is-ativo { color: var(--nav-cor-forte); }

  /* Filete da seção corrente. A marca fica no filete, não no texto: sublinhar
     o rótulo inteiro pesa demais para um item que só diz onde o visitante está. */
  .nav-l::after {
    content: ''; position: absolute; left: 15px; right: 15px; bottom: 8px;
    height: 1px; background: var(--wood);
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--d-base) var(--ease);
  }
  .nav-l.is-ativo::after { transform: scaleX(1); }

  .cab-cta {
    min-height: 44px; padding-inline: var(--s-3);
    background: var(--cta-fundo); color: var(--cta-texto); border-color: var(--cta-borda);
    transition: background var(--d-base) var(--ease), color var(--d-base) var(--ease),
                border-color var(--d-base) var(--ease);
  }
  .cab-cta:hover { background: transparent; color: var(--cta-borda); }
  /* Já está na página de contato: o botão vira lembrete, não convite. */
  .cab-cta.is-ativo { background: transparent; color: var(--cta-borda); }

  /* A barra fica acima do painel de tela cheia — sem isto o X some atrás
     dele e não há como fechar o menu a não ser pelo Esc. */
  .cab-in { position: relative; z-index: 1; }

  .menu-btn {
    display: none; background: none; border: 0; cursor: pointer;
    padding-inline: 10px; min-height: 44px;
    /* alinha o ícone com a marca em vez de flutuar pelo padding */
    align-items: center;
  }
  .menu-icone { display: block; width: 22px; }
  .menu-icone span {
    display: block; height: 1px; background: var(--marca-cor); margin: 5px 0;
    transition: background var(--d-base) var(--ease), transform var(--d-base) var(--ease);
  }
  /* Aberto, os dois traços viram X. Os 3px são metade da distância entre eles
     — 1px de traço mais 5px de margem entre irmãos, que colapsa para 5. */
  .menu-btn[aria-expanded="true"] .menu-icone span:first-child { transform: translateY(3px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] .menu-icone span:last-child { transform: translateY(-3px) rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) {
    .menu-icone span, .mob, .mob-l, .mob-cta { transition: none; }
  }

  /* ─── Mobile ───
     Tela cheia, e não a gaveta clara que descia sob a barra. A gaveta
     empilhava os itens rente à esquerda com um filete entre cada um: lia como
     sumário de documento, e o conteúdo da página continuava aparecendo
     embaixo dela, disputando a atenção com o menu. Agora o painel toma a tela
     inteira no preto do site e os destinos ficam centrados no vão — enquanto
     ele está aberto não há mais nada para ler, que é o ponto de um menu.

     Um degrau abaixo da barra no z-index: o PARKET e o X continuam por cima e
     clicáveis, como na referência. */
  /* A abertura tem duas partes: o preto chega, e as palavras assentam nele.

     Só o `hidden` fazia o menu trocar de um quadro para o outro — nada se
     movia, a tela simplesmente era outra, e é isso que lê como corte. */
  /* ─── O ritmo da abertura ───
     Os quatro números vivem juntos porque é assim que se mexe neles: mudar um
     sem os outros desmancha a sequência.

     Medidos no parket.com.br e comprimidos. Lá são 600ms de painel, links
     começando aos 400ms, 150ms de degrau e 800ms cada — 1,8s até o último
     item assentar, que é demais para um menu: quem toca ali quer navegar.
     Estes valores guardam o gesto e cortam o tempo pela metade.

     O que dá o caráter não é a lentidão, é a sequência: os destinos ficam
     parados em 20px até os 280ms, quando o preto já passou de 85%. O painel
     chega primeiro; as palavras entram nele depois. Sobrepor as duas partes
     — que era o que estava aqui, com os destinos partindo aos 90ms — funde
     tudo num gesto rápido só. */
  .mob {
    --mob-d: 450ms;         /* o preto */
    --mob-espera: 280ms;    /* quando o primeiro destino se mexe */
    --mob-passo: 90ms;      /* degrau entre um destino e o seguinte */
    --mob-item-d: 600ms;    /* a subida de cada um */

    position: fixed; inset: 0; z-index: calc(var(--z-header) - 1);
    background: var(--ground);
    overflow-y: auto; overscroll-behavior: contain;
    opacity: 0;
    /* A curva não é a --ease da casa, e é de propósito. A --ease é um
       ease-out forte: chega à metade em ~15% do tempo, ótimo para algo que
       precisa parecer já resolvido. Aqui o efeito é o contrário — a medição
       do parket.com.br dá um S simétrico, metade do caminho na metade do
       tempo, que é o que faz o preto parecer descer sobre a página em vez de
       aparecer nela. Mesma curva na ida e na volta: lá o fechamento também é
       simétrico, ~600ms nos dois sentidos. */
    transition: opacity var(--mob-d) cubic-bezier(.4, 0, .2, 1);
  }
  .mob.is-aberto { opacity: 1; }
  /* Fechando, o painel fica mais 280ms no DOM enquanto o preto sai. Sem isto
     o dedo que solta o X acerta um link que já não se vê. */
  .mob:not(.is-aberto) { pointer-events: none; }
  .mob[hidden] { display: none; }
  /* Os 64px são a altura da barra — o mesmo valor de `.cab-in` lá embaixo.
     Simétrico em cima e embaixo para que `justify-content: center` centre no
     vão que sobra, e não atrás do cabeçalho. */
  .mob-in {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: var(--s-6); min-height: 100%; padding-block: 64px;
  }
  .mob-l {
    padding: 0; border: 0; text-align: center;
    font-size: clamp(2rem, 8vw, 2.5rem); font-weight: 200; line-height: 1;
    color: var(--on-dark); letter-spacing: -.02em;
    transition: color var(--d-fast) var(--ease),
                opacity var(--mob-item-d) cubic-bezier(.4, 0, .2, 1),
                transform var(--mob-item-d) cubic-bezier(.4, 0, .2, 1);
  }
  .mob-l:hover, .mob-l:active { color: #FFFFFF; }
  /* As transições do .btn entram na conta: esta regra tem uma classe e um
     atributo de escopo, então ela substitui a do tokens.css inteira — sem
     `background` aqui, o CTA perderia o próprio hover. */
  .mob-cta {
    margin-top: var(--s-4); align-self: center;
    transition: background var(--d-fast) var(--ease),
                color var(--d-fast) var(--ease),
                opacity var(--mob-item-d) cubic-bezier(.4, 0, .2, 1),
                transform var(--mob-item-d) cubic-bezier(.4, 0, .2, 1);
  }

  .mob-l, .mob-cta { opacity: 0; transform: translateY(20px); }
  /* O atraso mora no estado aberto, e não na regra de base. Ao fechar ele
     deixa de valer e os cinco saem juntos: uma saída escalonada seguraria a
     porta, e quem fechou já decidiu. */
  .mob.is-aberto .mob-l,
  .mob.is-aberto .mob-cta {
    opacity: 1; transform: none;
    transition-delay: calc(var(--mob-espera) + var(--i, 0) * var(--mob-passo));
  }

  @media (max-width: 1080px) {
    .nav, .cab-cta { display: none; }
    .menu-btn { display: inline-flex; margin-left: auto; }
    .cab-in { min-height: 64px; gap: var(--s-3); }
  }
</style>

<script>
  const cab = document.querySelector<HTMLElement>('[data-cab]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu]');
  const mob = document.getElementById('menu-mob');

  /* Com o painel ocupando a tela, a página atrás não pode rolar junto: sem a
     trava, o dedo que erra o link arrasta o conteúdo escondido e a pessoa
     fecha o menu num lugar diferente de onde abriu. */
  function travarRolagem(travar: boolean) {
    document.documentElement.style.overflow = travar ? 'hidden' : '';
  }

  const calmo = matchMedia('(prefers-reduced-motion: reduce)');
  let relogioDeFechar: number | undefined;

  function abrirMenu() {
    /* A classe, e não o `hidden`: no meio da saída o painel ainda não tem o
       atributo, e ler por ele fazia este clique voltar sem fazer nada — o
       menu ficava impossível de reabrir até o fade terminar. Pela classe, o
       clique no meio da saída reverte a transição de onde ela está. */
    if (!mob || mob.classList.contains('is-aberto')) return;
    clearTimeout(relogioDeFechar);
    mob.hidden = false;

    /* Um reflow entre tirar o `hidden` e pôr a classe. Sem ele o navegador vê
       as duas mudanças no mesmo quadro, conclui que a opacidade sempre foi 1
       e não roda transição nenhuma — o menu voltaria a aparecer de um golpe.
       É a leitura de offsetWidth que força o cálculo no meio. */
    void mob.offsetWidth;

    mob.classList.add('is-aberto');
    menuBtn?.setAttribute('aria-expanded', 'true');
    travarRolagem(true);
  }

  function fecharMenu(devolverFoco = false) {
    /* Idem: se a classe já saiu, o fechamento está em curso e o relógio dele
       termina o serviço — não há o que refazer aqui. */
    if (!mob || !mob.classList.contains('is-aberto')) return;
    mob.classList.remove('is-aberto');
    menuBtn?.setAttribute('aria-expanded', 'false');
    travarRolagem(false);
    if (devolverFoco) menuBtn?.focus();

    /* O `hidden` só entra quando o preto terminou de sair — até lá o painel
       fica no DOM, invisível e sem pointer-events.

       Relógio, e não `transitionend`: o evento não vem se a aba estiver em
       segundo plano, se um novo clique interromper a transição no meio, ou se
       o sistema estiver em movimento reduzido, onde não há transição para
       terminar. Qualquer um dos três deixaria o menu preso, invisível e por
       cima da página.

       Os 500ms acompanham o --mob-d de 450ms do CSS: se um encolher, o outro
       encolhe junto, senão o painel volta a piscar no fim da saída. */
    clearTimeout(relogioDeFechar);
    relogioDeFechar = window.setTimeout(() => {
      if (mob && !mob.classList.contains('is-aberto')) mob.hidden = true;
    }, calmo.matches ? 0 : 500);
  }

  menuBtn?.addEventListener('click', () => {
    if (!mob) return;
    /* A classe, e não o `hidden`: durante os 280ms de saída o painel ainda
       está no DOM sem `hidden`, e ler o atributo faria este clique tentar
       fechar de novo o que já está fechando — o menu não reabriria. */
    if (mob.classList.contains('is-aberto')) fecharMenu();
    else abrirMenu();
  });

  // Âncora clicada no mobile: o menu precisa sair da frente do destino.
  mob?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => fecharMenu()));

  /* Esc devolve o foco ao botão; o clique no X já está sobre ele. */
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fecharMenu(true); });
  /* O painel agora vive fora do <header>, então precisa entrar nesta conta —
     sem ele, tocar em qualquer vão entre os links fecharia o menu. */
  document.addEventListener('click', (e) => {
    const alvo = e.target as Node;
    if (!cab?.contains(alvo) && !mob?.contains(alvo)) fecharMenu();
  });

  if (cab?.classList.contains('cab--transp')) {
    const aoRolar = () => cab.classList.toggle('is-rolado', window.scrollY > 40);
    aoRolar();
    addEventListener('scroll', aoRolar, { passive: true });
  }

  /* Seção corrente. A faixa de leitura é o terço superior da tela: medir pelo
     meio acende a próxima seção antes de o visitante chegar nela. */
  const elos = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-secao]'));
  const secoes = elos
    .map((a) => document.getElementById(a.dataset.secao!))
    .filter((s): s is HTMLElement => Boolean(s));

  if (secoes.length) {
    const visiveis = new Set<string>();
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) visiveis.add(e.target.id);
          else visiveis.delete(e.target.id);
        }
        const corrente = secoes.find((s) => visiveis.has(s.id))?.id ?? null;
        for (const a of elos) a.classList.toggle('is-ativo', a.dataset.secao === corrente);
      },
      { rootMargin: '-76px 0px -67% 0px', threshold: 0 },
    );
    for (const s of secoes) obs.observe(s);
  }
</script>
