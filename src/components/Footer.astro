---
/**
 * Rodapé da one page.
 *
 * A coluna de navegação virou âncora da própria página; a de "Especificar"
 * virou a lista de catálogos publicados, que são links reais e externos —
 * o rodapé antigo apontava para /arquitetos/texturas e /arquitetos/fichas,
 * que não existem mais.
 */
import Icone from './Icone.astro';
import { categoriasOrdenadas } from '../lib/catalogo';
import { catalogoDaCategoria, CATALOGOS_AVULSOS } from '../lib/catalogos';
import { caminho } from '../lib/url';

const showrooms = [
  { cidade: 'São Paulo', linhas: ['Avenida Magalhães de Castro, 4800', 'Torre 1, Edifício Capital · Cj. 201', 'Jardim Panorama — São Paulo · SP'] },
  { cidade: 'Brasília',  linhas: ['SHIS QI 21 BL B, Ed. IAS 06/58', 'Lago Sul — Brasília · DF'] },
];

const naPagina = [
  { nome: 'Superfícies', href: caminho('/#superficies') },
  { nome: 'Madeiras',    href: caminho('/#madeiras') },
  { nome: 'Acervo',      href: caminho('/#acervo') },
  { nome: 'Blog',        href: caminho('/blog') },
  { nome: 'Contato',     href: caminho('/contato') },
];

/* Só entra quem tem catálogo publicado — Portas não tem, e some da lista. */
const catalogos = [
  ...categoriasOrdenadas
    .map((c) => ({ nome: c.nome, href: catalogoDaCategoria(c.id) }))
    .filter((c): c is { nome: string; href: string } => Boolean(c.href)),
  ...CATALOGOS_AVULSOS.map((c) => ({ nome: c.nome, href: c.href })),
];

const sociais = [
  { nome: 'Instagram', href: 'https://www.instagram.com/parketpisos/' },
  { nome: 'YouTube',   href: 'https://www.youtube.com/@Parketoficial' },
  { nome: 'Pinterest', href: 'https://br.pinterest.com/parketpisosrevestimentos/' },
];

const ano = new Date().getFullYear();
---

<footer class="rod tom-escuro">
  <div class="wrap">
    {/* Uma faixa só. Eram duas — marca+navegação em cima, endereços embaixo —
        e cada uma trazia o próprio padding de --s-8: o rodapé passava de 900px
        de altura, três quartos de uma tela, para dizer o que cabe em cinco
        colunas. Os contatos subiram para junto da marca, que é onde o olho já
        procura quem é a empresa e como falar com ela. */}
    <div class="rod-grade">
      <div class="rod-marca">
        <p class="marca">Parket</p>
        <p class="rod-frase">Superfícies naturais desenvolvidas para projetos que atravessam o tempo.</p>
        <a class="btn btn-on-dark rod-cta" href={caminho("/contato")}>Falar com um especialista</a>
        <address class="rod-contatos">
          <span class="rod-contato">
            <Icone nome="email" class="icone--detalhe" />
            <a href="mailto:contato@parket.com.br">contato@parket.com.br</a>
          </span>
          <span class="rod-contato">
            <Icone nome="telefone" class="icone--detalhe" />
            <a href="tel:+5511999600222">+55 11 99960-0222</a>
          </span>
        </address>

        <div class="rod-news">
          <p class="label">Newsletter</p>
          <p class="rod-news-txt">Receba novidades sobre lançamentos e projetos.</p>

          <form class="rod-news-form" data-news>
            <label class="sr-only" for="rod-email">Seu e-mail</label>
            <input
              class="rod-news-campo" type="email" id="rod-email" name="email"
              placeholder="seu@email.com" autocomplete="email" required
            />
            <button class="rod-news-btn" type="submit">Assinar</button>
          </form>

          {/* role="status" e não um alert: a confirmação é anunciada quando o
              leitor de tela chegar num intervalo, sem interromper o que
              estiver lendo. Nasce escondida e o script a revela. */}
          <p class="rod-news-ok" data-news-ok role="status" hidden>
            Obrigado! Você receberá nossas novidades em breve.
          </p>
          <p class="rod-news-erro" data-news-erro role="status" hidden>
            Não deu para enviar agora. Escreva para
            <a href="mailto:contato@parket.com.br">contato@parket.com.br</a>.
          </p>
        </div>
      </div>

      {/* Dois <nav> rotulados em vez de um só englobando as duas listas: com
          rótulo cada um vira um ponto de salto nomeado para quem navega por
          landmarks, e o `display: contents` que seria preciso para achatar um
          <nav> pai em colunas do grid não é confiável na árvore de
          acessibilidade. */}
      <nav class="rod-bloco" aria-label="Na página">
        <p class="label">Na página</p>
        <ul>{naPagina.map((l) => <li><a href={l.href}>{l.nome}</a></li>)}</ul>
      </nav>

      <nav class="rod-bloco" aria-label="Catálogos">
        <p class="label">Catálogos</p>
        <ul>{catalogos.map((c) => (
          <li><a href={c.href} rel="noopener noreferrer" target="_blank">{c.nome}</a></li>
        ))}</ul>
      </nav>

      <div class="rod-bloco rod-shows">
        {showrooms.map((s) => (
          <div class="rod-show">
            <p class="label">Showroom {s.cidade}</p>
            <address>{s.linhas.map((l) => <span>{l}</span>)}</address>
          </div>
        ))}
      </div>

    </div>

    <div class="rod-base">
      <ul class="rod-sociais">
        {sociais.map((s) => (
          <li><a href={s.href} rel="noopener noreferrer" target="_blank">{s.nome}</a></li>
        ))}
      </ul>
      <p class="caption rod-copy">© {ano} Parket. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>

<style>
  /* O bloco de pedido que vem antes também é --ground: sem o filete os dois
     viram uma mancha escura só e o rodapé perde o começo. */
  /* Fundo e cor de texto vêm do `.tom-escuro` na tag, e não daqui.
     Repetidos neste bloco, o rodapé ficava escuro sem se declarar escuro — e
     as correções que o tokens.css aplica em `.tom-escuro` (caption, label,
     badge, títulos) passavam longe. O copyright herdava o `--muted`, que é
     calibrado para papel: 3,53:1 sobre o preto do rodapé, abaixo do mínimo de
     4,5:1 para texto. Com a classe, ele passa a usar `--on-dark-muted`.

     `.tom-escuro .btn` e `.btn-on-dark` declaram exatamente as mesmas cores,
     então o botão do rodapé não muda. */
  .rod {
    padding-block: var(--s-8) var(--s-4);
    border-top: 1px solid rgb(232 228 223 / .14);
  }
  /* `:not(.btn)` não é preciosismo: `.rod a` tem especificidade 0,1,1 e vence
     `.btn-on-dark` (0,1,0), então o `color: inherit` daqui pintava o texto do
     botão com a cor do rodapé — mesma cor do fundo dele. O botão sumia e
     sobrava um retângulo claro vazio. O botão traz a própria cor e o próprio
     hover; a regra de link cuida só dos links. */
  .rod a:not(.btn) { color: inherit; transition: color var(--d-fast) var(--ease); }
  .rod a:not(.btn):hover { color: var(--wood); }
  .rod .label { color: var(--on-dark-muted); display: block; margin-bottom: var(--s-2); }

  /* Quatro colunas numa faixa só. A marca é a mais larga porque carrega
     tudo o que é da empresa — a frase, o botão, os contatos e a assinatura
     da newsletter; as duas de link são as mais estreitas porque só têm
     palavras curtas. */
  .rod-grade {
    display: grid;
    grid-template-columns:
      minmax(0, 1.5fr) minmax(0, .8fr) minmax(0, .8fr) minmax(0, 1.2fr);
    gap: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid rgb(232 228 223 / .14);
  }
  .rod-marca .marca {
    font-size: 1.125rem; font-weight: 300; letter-spacing: .34em;
    text-transform: uppercase; color: var(--on-dark); margin-bottom: var(--s-2);
  }
  .rod-frase { font-size: var(--fs-small); color: var(--on-dark-muted); max-width: 34ch; line-height: 1.55; }
  .rod-cta { margin-top: var(--s-3); }
  .rod-contatos { display: block; margin-top: var(--s-3); font-style: normal; }

  .rod-bloco li { margin-bottom: 6px; font-size: var(--fs-small); }
  /* Os dois showrooms empilham dentro da mesma coluna: são dois endereços
     curtos, e cada um numa coluna própria abria a faixa para sete colunas
     estreitas demais para caber "Avenida Magalhães de Castro, 4800". */
  .rod-shows { display: flex; flex-direction: column; gap: var(--s-4); }
  .rod-show address { font-style: normal; font-size: var(--fs-small); line-height: 1.6; color: var(--on-dark-muted); }
  .rod-show address span { display: block; }
  .rod-contatos { font-size: var(--fs-small); line-height: 1.6; color: var(--on-dark-muted); }
  .rod-contatos .rod-contato { display: flex; align-items: flex-start; gap: 10px; }
  /* Alinhado pelo topo com um empurrão de 3px: o glifo é uma caixa de 16px e
     o texto tem line-height 1.6 — centralizar pelo eixo deixaria o glifo
     abaixo da primeira letra. */
  /* Precisa repetir `.rod-show address` na frente: escopado, o seletor de
     cima vira `.rod-show address span[data-astro-cid]` e ganha de um
     `.rod-contato[data-astro-cid]` sozinho — o glifo caía numa linha
     própria, acima do endereço. */
  .rod-show address span.rod-contato { display: flex; align-items: flex-start; gap: 10px; }
  .rod-contato :global(.icone) { margin-top: 3px; }

  /* ─── Newsletter ───
     Fechava a faixa numa quinta coluna e agora vive no fim da coluna da
     marca: assinar novidades é falar com a empresa, o mesmo assunto do
     botão e dos contatos logo acima — e a faixa perdeu uma coluna, que foi
     dar largura para as que sobraram.

     Escala miúda e botão em texto: o assunto tem o peso de um dado de
     rodapé, não o de uma seção, e um .btn de 48px aqui competiria com o
     "Falar com um especialista" que está três linhas acima. */
  .rod-news { margin-top: var(--s-3); padding-top: var(--s-2); border-top: 1px solid rgb(232 228 223 / .14); }
  .rod-news-txt {
    font-size: var(--fs-caption); line-height: 1.55;
    color: var(--on-dark-muted); max-width: 34ch;
  }

  /* Campo e botão na mesma linha: a coluna da marca é a mais larga da faixa
     e comporta os dois, o que poupa a altura que o empilhamento custava. */
  .rod-news-form {
    margin-top: var(--s-2);
    display: flex; align-items: center; gap: var(--s-3);
  }
  /* Mesmo desenho dos campos do formulário — filete embaixo e nada mais —
     mas na escala do escuro: a linha é o branco a 24%, e não a --line, que
     sumiria no --ground. */
  .rod-news-campo {
    flex: 1 1 auto; min-width: 0; min-height: 40px; padding: 0 0 6px;
    background: transparent; color: var(--on-dark);
    border: 0; border-bottom: 1px solid rgb(232 228 223 / .24);
    border-radius: 0; font-size: var(--fs-small);
    transition: border-color var(--d-fast) var(--ease);
  }
  .rod-news-campo::placeholder { color: var(--on-dark-muted); }
  .rod-news-campo:focus { outline: none; border-bottom-color: var(--wood); }
  .rod-news-campo:focus-visible { outline: 2px solid var(--wood); outline-offset: 4px; }

  .rod-news-btn {
    flex: none;
    padding: 4px 0; background: none; border: 0; cursor: pointer;
    font-size: var(--fs-label); font-weight: 500;
    letter-spacing: var(--ls-label); text-transform: uppercase;
    color: var(--on-dark); border-bottom: 1px solid var(--wood);
    transition: color var(--d-fast) var(--ease);
  }
  .rod-news-btn:hover { color: var(--wood); }

  .rod-news-ok, .rod-news-erro { margin-top: var(--s-2); font-size: var(--fs-caption); line-height: 1.5; }
  .rod-news-ok { color: var(--wood); }
  .rod-news-erro { color: var(--on-dark-muted); }
  .rod-news-erro a { text-decoration: underline; text-underline-offset: 3px; }

  /* ─── Base: redes e direitos ───
     As redes moravam numa coluna "Acompanhe" ao lado de Na página e
     Catálogos. Desceram para cá porque não são conteúdo do site, e porque
     repeti-las nos dois lugares seria oferecer três links como se fossem
     seis. */
  .rod-base {
    display: flex; flex-direction: column; align-items: center; gap: var(--s-2);
    color: var(--on-dark-muted); padding-top: var(--s-4);
  }
  .rod-sociais { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-6); }
  .rod-sociais a {
    font-size: var(--fs-label); font-weight: 500;
    letter-spacing: var(--ls-label); text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .rod-copy { text-align: center; }

  /* A faixa vai perdendo colunas em vez de espremer as cinco. Três, e não
     quatro: em quatro, a coluna fica com ~190px e "Avenida Magalhães de
     Castro, 4800" quebra em duas linhas — o endereço é o que define a
     largura mínima útil aqui. A marca continua sendo uma coluna como as
     outras; esticá-la na linha inteira só empurrava todo o resto para baixo. */
  /* ─── Alvos de toque no rodapé ───
     Link de lista com 20px de altura e 6px de respiro entre um e outro é
     difícil de acertar e fácil de errar para o vizinho. Vira bloco com
     padding, e a margem some para a coluna não crescer o dobro: cada item
     passa de 26px para 34px, +8px, e não +14px. */
  @media (max-width: 640px) {
    .rod-bloco li { margin-bottom: 0; }
    .rod-bloco li a { display: block; padding-block: 9px; }
    /* O padding vai no <a>, não no <span> que embrulha glifo e link: quem
       toca acerta o link, e é a altura dele que conta. */
    .rod-contatos { gap: 0; }
    .rod-contatos a { display: block; padding-block: 8px; }
    .rod-contatos .rod-contato { align-items: center; }
    .rod-sociais { gap: var(--s-2) var(--s-6); }
    .rod-sociais a { display: block; padding-block: 12px; }
    .rod-news-btn { padding-block: 12px; }
  }

  @media (max-width: 1180px) {
    .rod-grade { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-6); }
    /* Coluna mais estreita: o campo volta a ocupar a linha inteira, com o
       botão embaixo. */
    .rod-news-form { flex-direction: column; align-items: flex-start; gap: var(--s-2); }
    .rod-news-campo { width: 100%; flex: none; }
  }
  @media (max-width: 860px) {
    .rod-grade { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4) var(--s-6); }
  }
  /* No celular tudo empilhado dava um rodapé de quase mil e quinhentos
     pixels. As duas listas de link continuam lado a lado — são palavras
     curtas e cabem em meia largura; quem precisa da largura inteira é o
     endereço, a frase da marca e o campo de e-mail. */
  @media (max-width: 480px) {
    .rod-grade { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rod-marca, .rod-shows { grid-column: 1 / -1; }
  }
</style>

<script>
  /* ÚNICO PONTO A MEXER quando o serviço de newsletter estiver contratado:
     cole aqui a URL de inscrição (Formspree, Buttondown, Brevo, Mailchimp via
     proxy…). O resto do rodapé não muda.

     Enquanto estiver vazio o formulário não finge: diz que não deu para
     enviar e oferece o e-mail da casa. Ele NÃO chama mais `mailto:`. A versão
     anterior mandava a pessoa para o cliente de e-mail — que no celular quase
     nunca existe —, e era isso que tirava o visitante da página. É o mesmo
     defeito que o formulário de orçamento já tinha abandonado; ver o
     comentário no topo do Formulario.astro. */
  const ENDPOINT = '';

  const form = document.querySelector<HTMLFormElement>('[data-news]');
  const aviso = document.querySelector<HTMLElement>('[data-news-ok]');
  const erro = document.querySelector<HTMLElement>('[data-news-erro]');
  const botao = form?.querySelector<HTMLButtonElement>('button[type=submit]');

  if (form && aviso && erro && botao) {
    const rotulo = botao.textContent;
    let enviando = false;

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      /* Valida com o próprio navegador: a mensagem de "e-mail inválido" sai
         no idioma do sistema e ancorada no campo, de graça. */
      if (enviando || !form.reportValidity()) return;

      const email = String(new FormData(form).get('email') ?? '');
      erro.hidden = true;

      /* Sem serviço não há cadastro — e agradecer por um cadastro que não
         aconteceu é pior do que não ter o campo. */
      if (!ENDPOINT) { erro.hidden = false; return; }

      enviando = true;
      botao.disabled = true;
      botao.textContent = 'Enviando…';

      try {
        const resposta = await fetch(ENDPOINT, {
          method: 'POST',
          /* O Accept é o que faz o Formspree responder JSON em vez de
             redirecionar o navegador para a página de obrigado dele. */
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (!resposta.ok) throw new Error(String(resposta.status));
      } catch {
        /* Falhou de verdade: quem preencheu precisa saber, e não receber um
           agradecimento por um cadastro que não aconteceu. */
        erro.hidden = false;
        enviando = false;
        botao.disabled = false;
        botao.textContent = rotulo;
        return;
      }

      /* Só agora, e só depois de o serviço confirmar. */
      form.hidden = true;
      aviso.hidden = false;
    });
  }
</script>
