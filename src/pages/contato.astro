---
/**
 * A segunda e última página do site.
 *
 * Existe por um motivo só: receber o pedido. Não tem navegação de conteúdo,
 * não tem seção de venda — quem chega aqui já foi convencido pela home. É uma
 * seção única: o convite, o que reduz a desistência (prazo de resposta,
 * canais diretos, showrooms) e o formulário, tudo junto.
 *
 * Quando a pessoa chega de um nome clicado na home, a referência vem em `?ref=`
 * e o formulário mostra o campo já preenchido.
 */
import Base from '../layouts/Base.astro';
import Formulario from '../components/Formulario.astro';

const titulo = 'Falar com um Especialista em Madeira | Parket';
const descricao = 'Fale com a equipe técnica da Parket sobre o seu projeto: espécie, bitola, acabamento, prazo e instalação. Showrooms em São Paulo e Brasília. Resposta em até um dia útil.';


const schema = {
  '@type': 'ContactPage',
  name: 'Contato Parket',
  description: descricao,
};

const canais = [
  { rotulo: 'WhatsApp', valor: '+55 11 99960-0222', href: 'https://wa.me/5511999600222', externo: true },
  { rotulo: 'Telefone', valor: '+55 11 99960-0222', href: 'tel:+5511999600222', externo: false },
  { rotulo: 'E-mail',   valor: 'contato@parket.com.br', href: 'mailto:contato@parket.com.br', externo: false },
];
---

<Base {titulo} {descricao} {schema}>
  <!-- Uma seção só, como na home. Antes o formulário abria a página e o bloco
       "Vamos conversar sobre o seu projeto" vinha depois, repetindo o convite
       que o título do formulário já faz — e empurrando os canais diretos para
       o fim da página, longe de quem hesita no primeiro campo.

       Sobreviveu o h1 do formulário, que é o que a busca indexa; o parágrafo
       do bloco de baixo, mais concreto sobre o que a equipe responde, tomou o
       lugar do subtítulo antigo. -->
  <Formulario
    comoH1
    rotulo="Contato"
    titulo="Falar com um especialista."
    subtitulo="Conte o que está projetando. A equipe técnica responde com espécie, bitola, acabamento, prazo e método de instalação — não com um catálogo genérico. Se você chegou de uma referência, ela vem junto e adianta a conversa."
    acao="Falar com um especialista"
  >
    <ul class="canais" slot="lado">
      {canais.map((c) => (
        <li class="canal">
          <span class="label">{c.rotulo}</span>
          <a
            class="canal-valor"
            href={c.href}
            rel={c.externo ? 'noopener noreferrer' : undefined}
            target={c.externo ? '_blank' : undefined}
          >{c.valor}</a>
        </li>
      ))}
    </ul>
  </Formulario>
</Base>

<style>
  /* Os canais entram no slot "lado" do formulário, logo abaixo de Resposta e
     Showrooms. Filete de --ink no topo para a lista não virar continuação da
     <dl> de cima, que usa --line: são duas listas com o mesmo desenho e uma
     precisa começar. */
  .canais { margin-top: var(--s-4); border-top: 1px solid var(--ink); }
  .canal {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--s-3); padding: 13px 0; border-bottom: 1px solid var(--line-soft);
  }
  .canal-valor { font-size: var(--fs-small); color: var(--ink); transition: color var(--d-fast) var(--ease); }
  .canal-valor:hover { color: var(--wood-text); }

</style>
