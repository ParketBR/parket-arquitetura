---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';

interface Props {
  titulo: string;
  descricao: string;
  /** Caminho da imagem social. Cada página tem a sua — nunca a mesma para todas. */
  imagem?: string;
  /** Descreve a imagem social. Sem ela, o alt é o título da página. */
  imagemAlt?: string;
  /** JSON-LD adicional da página (Product, Article, CollectionPage…). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Trilha de navegação: [{ nome, url }] — vira BreadcrumbList. */
  trilha?: { nome: string; url: string }[];
  headerTransparente?: boolean;
}

const {
  titulo, descricao, imagem, imagemAlt,
  schema, trilha = [], headerTransparente = false,
} = Astro.props;

import { getImage } from 'astro:assets';
import { caminho } from '../lib/url';
import { assetLocal, ehRemota } from '../lib/imagens';

const site = Astro.site ?? new URL('https://parket.com.br');
const canonica = new URL(Astro.url.pathname, site).href;

/* ─── Imagem da prévia do link ───
   1200×630 é a proporção 1,91:1 que Facebook, WhatsApp, LinkedIn e Telegram
   recortam. Fora dela o card vira miniatura quadrada ao lado do texto.

   O peso importa tanto quanto a medida: o WhatsApp desiste de baixar a prévia
   por volta de 300 KB e mostra só o título. Era o caso — o `og:image` da home
   apontava para a FOTO HERO do WordPress, 1,18 MB, e nenhum link compartilhado
   abria com imagem. Toda foto local passa pelo pipeline do Astro e sai em
   JPEG recortado; o padrão é public/og-parket.jpg, gerado por scripts/og.mjs.

   JPEG, e não o AVIF/WebP do resto do site: os robôs de prévia do WhatsApp e
   do LinkedIn ainda não leem os dois. */
const OG_L = 1200, OG_A = 630;

const assetSocial = imagem && !ehRemota(imagem) ? assetLocal(imagem) : null;

const ogImagem = assetSocial
  ? new URL(
      (await getImage({
        src: assetSocial, width: OG_L, height: OG_A,
        fit: 'cover', format: 'jpeg', quality: 78,
      })).src,
      site,
    ).href
  : imagem && ehRemota(imagem)
    ? imagem
    : new URL(caminho('/og-parket.jpg'), site).href;

const ogAlt = imagemAlt ?? titulo;

const organizacao = {
  '@type': 'Organization',
  '@id': `${site.origin}/#organizacao`,
  name: 'Parket',
  url: site.origin,
  description: 'Pisos, decks, forros, painéis, escadas e portas em madeira nobre para arquitetura.',
  telephone: '+55 11 99960-0222',
  email: 'contato@parket.com.br',
  sameAs: [
    'https://www.instagram.com/parketpisos/',
    'https://www.youtube.com/@Parketoficial',
    'https://br.pinterest.com/parketpisosrevestimentos/',
  ],
};

const breadcrumb = trilha.length
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: trilha.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.nome,
        item: new URL(t.url, site).href,
      })),
    }
  : null;

const grafo = [
  organizacao,
  breadcrumb,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
].filter(Boolean);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Parket" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content={String(OG_L)} />
    <meta property="og:image:height" content={String(OG_A)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogAlt} />

    {/* O card do Twitter/X não herda as og:*. E o WhatsApp, quando as duas
        famílias existem, lê a que vier com medida declarada — por isso as
        larguras acima ficam antes. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={ogImagem} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href={caminho("/favicon.ico")} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={caminho("/favicon-32x32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={caminho("/favicon-16x16.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={caminho("/apple-touch-icon.png")} />
    <meta name="theme-color" content="#F5F2EC" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,200;9..40,300;9..40,400;9..40,500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo })} />
  </head>

  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>
    <Header transparente={headerTransparente} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <BotaoWhatsApp />

    <script>
      /* ─── Reveal na entrada ───
         Dois tipos de alvo: a seção (.reveal) e o bloco (.rev). Ver a nota
         em tokens.css sobre por que o bloco existe. */
      const alvos = Array.from(document.querySelectorAll<HTMLElement>('.reveal, .rev'));
      const mostrarTudo = () => alvos.forEach((e) => e.classList.add('is-in'));

      if (!('IntersectionObserver' in window) ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        mostrarTudo();
      } else {
        let respondeu = false;

        const obs = new IntersectionObserver(
          (entradas) => {
            respondeu = true;

            /* Escalonamento por leva. O atraso de cada bloco é a posição dele
               na tela entre os que entraram nesta mesma chamada — os quatro
               cartões de uma fileira sobem em cascata, e o bloco que entra
               sozinho não espera nada.

               O teto de 5 existe para o último de uma lista longa não ficar
               meio segundo atrás do primeiro. */
            const chegando = entradas
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

            chegando.forEach((e, i) => {
              const alvo = e.target as HTMLElement;
              alvo.style.setProperty('--i', String(Math.min(i, 5)));
              alvo.classList.add('is-in');
              obs.unobserve(alvo);
            });
          },
          {
            /* Margem negativa embaixo, e não os +240px de antes. Com a margem
               positiva o bloco acendia fora da tela: no celular, onde quase
               toda seção é mais alta que a janela, isso queria dizer que o
               site abria pronto. Agora ele acende ao cruzar a borda de baixo,
               com uma folga de 8% para o movimento começar antes de o bloco
               estar todo à vista. */
            rootMargin: '0px 0px -8% 0px',
            threshold: 0,
          },
        );
        alvos.forEach((e) => obs.observe(e));

        /* Rede de segurança para nunca deixar conteúdo invisível.

           A anterior revelava tudo depois de 4s, o que no celular acendia as
           treze telas da home antes de o dedo chegar na segunda seção — ela
           sozinha já anulava o efeito. Esta pergunta outra coisa: o observer
           deu sinal de vida? Ele chama o callback logo na primeira volta,
           para todos os alvos, mesmo os que estão longe da tela. Se em 3s não
           chamou nenhuma vez, não vai chamar — aí sim mostra tudo. */
        setTimeout(() => { if (!respondeu) mostrarTudo(); }, 3000);
      }
    </script>
  </body>
</html>
